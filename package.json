{
  "name": "azadi-connect",
  "productName": "Azadi Connect",
  "version": "0.4.1",
  "description": "Bilingual Windows VPN client with application routing. For Iran ❤️",
  "author": "Saman Salehi and the Azadi Connect contributors",
  "license": "GPL-3.0-or-later",
  "main": "app/main.cjs",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "assets": "node scripts/assets.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "build:guardian": "node scripts/build-guardian.mjs",
    "build:win": "npm run assets && npm run build:guardian && electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never",
    "test:startup": "node scripts/startup-smoke.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.2",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "org.azadi.connect",
    "productName": "Azadi Connect",
    "copyright": "Copyright © 2026 Azadi Connect contributors",
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Azadi-Connect-${version}-Windows-x64-Setup.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "script": "build/installer.nsi",
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "fa_IR"
      ],
      "language": "1033",
      "license": "LICENSE"
    }
  }
}
